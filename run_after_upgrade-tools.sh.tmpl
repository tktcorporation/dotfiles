#!/bin/bash
# mise 管理のランタイム/CLI を導入し、config.toml の範囲内で最新版へ追従させる。
#
# run_onchange ではなく run_after (apply 毎に実行) にしているのは、config.toml を
# 範囲指定 (node = "lts", pnpm = "12" 等) にしたため。設定ファイルが変わらなくても
# 上流でセキュリティ修正が出たら次の apply で取り込みたい。
# `mise upgrade` は範囲を越えない (メジャーを勝手に上げない) ので apply 毎でも安全。
# 範囲自体を上げたいときは config.toml を編集する。
set -euo pipefail

# mise の npm バックエンド (npm:@devcontainers/cli 等) が依存を解決するときにも
# npm のクールダウン (README「サプライチェーン対策」) を効かせる。
# 普段は mise の [env] (dot_config/mise/config.toml) から渡るが、mise install 中の
# npm 実行に [env] が渡る保証がない (初回 bootstrap 時は mise 自体が未有効化) ため、ここでも明示する。
export npm_config_min_release_age=0.5

# 兄弟スクリプト (install-packages) の load_brew_shellenv は別プロセスなので PATH が
# 引き継がれない。初回 bootstrap など brew が PATH に無い環境でも動くよう、ここでも読み込む。
# shellcheck source=scripts/bootstrap-lib.sh
source "{{ joinPath .chezmoi.sourceDir "scripts" "bootstrap-lib.sh" }}"
load_brew_shellenv

if command -v mise &>/dev/null; then
  echo "Installing / upgrading mise-managed tools..."
  mise install --yes
  mise upgrade --yes
fi
